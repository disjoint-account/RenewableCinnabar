	"description": "A simple mod to make Cinnabar renewable in a thematically appropriate and easily farmable manner.",
	"authors": [
		"disjoint"
	],
	"contact": {
		"homepage": "https://modrinth.com/project/renewablecinnabar",
		"sources": "https://github.com/disjoint-account/RenewableCinnabar",
		"issues": "https://github.com/disjoint-account/RenewableCinnabar/issues"
	},
	"license": "MIT",
	"icon": "assets/renewablecinnabar/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.disjoint.renewablecinnabar.RenewableCinnabar"
		],
		"fabric-datagen": [
			"net.disjoint.renewablecinnabar.RenewableCinnabarDataGenerator"
		]
	},
	"mixins": [
		"renewablecinnabar.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
